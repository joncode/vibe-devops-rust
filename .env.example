# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibe_devops
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vibe:dev

# Authentication
JWT_SECRET=change-this-to-a-secure-secret-at-least-32-chars
JWT_EXPIRY_HOURS=1
REFRESH_TOKEN_EXPIRY_DAYS=7
SESSION_EXPIRY_DAYS=30

# Logging
RUST_LOG=info,vibe_devops_server=debug,sqlx=warn,tower_http=debug
